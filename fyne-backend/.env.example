# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Number of reverse-proxy hops in front of the API (Nginx/Render/Railway = 1)
TRUST_PROXY=1

# ── Database ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://planetsatplayseo_db_user:
REDIS_URL=redis://localhost:6379

# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=FYNE SURFACES <hello@your-verified-domain.com>
# Optional internal notification recipients (not the sender address)
CONTACT_TO_EMAIL=hello@yourdomain.com
ORDER_NOTIFICATION_EMAIL=orders@yourdomain.com
# Optional Nodemailer SMTP transport; used when all SMTP values are configured.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# ── JWT (use 64+ random chars each: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=long random string of 64+ characters
JWT_REFRESH_SECRET=long random string 
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
CUSTOMER_REFRESH_EXPIRES_DAYS=7

# ── URLs / CORS ──────────────────────────────────────────
# Comma-separated list of allowed browser origins (storefront + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://fyne-surface.vercel.app,https://fyne-surface-qivi.vercel.app,https://fyne-surface.onrender.com
# Public storefront URL — used for canonical URLs, sitemap and JSON-LD
SITE_URL=https://www.fynesurfaces.com
# Public URL of this API (used in llms.txt / feeds)
API_URL=http://localhost:5000

# ── ImageKit ─────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=public_your-public-key
IMAGEKIT_PRIVATE_KEY=private_your-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-imagekit-id
IMAGEKIT_FOLDER=fyne-surfaces

# ── Payments (gateway-agnostic) ──────────────────────────
# mock | razorpay | stripe   (only "mock" is implemented today)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-webhook-signing-secret

# ── Inventory ────────────────────────────────────────────
LOW_STOCK_THRESHOLD=5
MOCK_SHIPPING_FEE=100


