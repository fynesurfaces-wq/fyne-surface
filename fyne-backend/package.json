{
  "name": "fyne-surfaces-api",
  "version": "1.0.0",
  "description": "Backend API + Shopify-like admin backend for FYNE SURFACES (Premium Vertical Garden)",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm install",
    "seed": "node src/seed/seed.js",
    "import:plants": "node src/seed/import-plants.js",
    "import:bushes": "node src/seed/import-bushes.js",
    "import:creepers": "node src/seed/import-creepers.js",
    "rename:creepers-bushes": "node src/seed/rename-creepers-bushes.js",
    "import:premium-greenwall": "node src/seed/import-premium-greenwall.js",
    "import:exclusive-greenwall": "node src/seed/import-exclusive-greenwall.js",
    "import:economy-greenwall": "node src/seed/import-economy-greenwall.js",
    "normalize:product-names": "node src/seed/make-product-names-unique.js",
    "seed:destroy": "node src/seed/seed.js --destroy"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^10.6.1",
    "redis": "^4.7.1",
    "sanitize-html": "^2.14.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "nodemon": "3.1.11"
  }
}
