# Express API origin — used by server components (SSR/ISR) and the rewrite proxy
API_ORIGIN=http://localhost:5000

# Public storefront URL — canonical URLs, OpenGraph, metadataBase
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# "true" in development: after "Place Order", fire the backend's signed mock
# payment webhook so the order becomes Paid. Set to "false" once a real
# gateway (Razorpay/Stripe) is integrated.
NEXT_PUBLIC_MOCK_PAYMENTS=true
